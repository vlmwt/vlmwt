{
  "name": "vlmwt",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vlmwt",
      "database_id": "3a641e47-4b58-423f-a631-6e242b8cd2ae"
    }
  ]
}
